# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Environment
.env
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Confidential deal data — NEVER commit
*.pdf
deals/
overrides/*.json

# Database (local instance — not committed)
# The entry is a literal path, not a glob, so the WAL sidecars need their own
# lines: the DB opens in WAL mode, so every read recreates them and they
# otherwise show as untracked noise in every `git status` (and in the
# primary-tree drift detector, which reads `git status`).
data/cim_comps.db
data/cim_comps.db-wal
data/cim_comps.db-shm

# Logs
*.log
logs/

# Temp files
tmp*

# OS
.DS_Store
Thumbs.db

# Generated output files
SS_Investment_Memo_*.docx
SS_Returns_Model_*.xlsx

# Excel macro files (includes UW template with deal data)
*.xlsm

# Dropbox extended attributes
*.pdf:com.dropbox.attrs

# Claude Code local state (settings.json + hooks/ are tracked so every session
# inherits the permission allowlist and the mandatory session-guard hooks;
# .claude/worktrees/ and settings.local.json stay ignored via the wildcard)
.claude/*
!.claude/settings.json
!.claude/hooks/
.superpowers/

# Other AI tooling scratch workspaces (plans worth keeping get moved into docs/)
.kilo/

# Django front end
db.sqlite3
staticfiles/
