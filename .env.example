# CIM Analyst — Environment Variables
# Copy to .env and fill in values

# Census API key for demographic enrichment (optional)
CENSUS_API_KEY=

# Data paths (defaults work for local dev — render.yaml sets these in prod)
# COMP_DB_PATH=/data/cim_comps.db
# CIM_DEALS_DIR=/data/deals
# CIM_OVERRIDES_DIR=/data/overrides

# Underwriting template path (optional — defaults to template_uw.xlsm in project root)
# UW_TEMPLATE_PATH=/app/template_uw.xlsm

# GP display name for the underwriting template (optional)
# The old GP_EQUITY_SHARE / GP_AM_FEE_RATE / GP_PROMOTE_PCT vars were removed
# in item E3b — fund structure lives in config.py and per-deal inputs now.
# GP_NAME=GP
