# CIM Analyst — Environment Variables
# Copy to .env and fill in values

# Census API key for demographic enrichment (optional)
CENSUS_API_KEY=

# AI extraction gap-filler (item B1) — OFF unless BOTH are set. When enabled,
# the extraction path sends CIM *text* to a third-party API (DeepSeek by
# default) to fill fields the regex parser missed. CIMs are confidential
# offering memoranda: enabling this is a deliberate data-egress decision.
# AI_EXTRACTION_ENABLED=1
# DEEPSEEK_API_KEY=
# Optional overrides (defaults shown):
# AI_EXTRACTION_BASE_URL=https://api.deepseek.com
# AI_EXTRACTION_MODEL=deepseek-chat

# Data paths (defaults work for local dev — set these for Docker)
# COMP_DB_PATH=/data/cim_comps.db
# CIM_DEALS_DIR=/data/deals
# CIM_OVERRIDES_DIR=/data/overrides

# Underwriting template path (optional — defaults to template_uw.xlsm in project root)
# UW_TEMPLATE_PATH=/app/template_uw.xlsm

# Fund structure defaults for underwriting template (optional)
# GP_NAME=GP
# GP_EQUITY_SHARE=0.08
# GP_AM_FEE_RATE=0.01
# GP_PROMOTE_PCT=0.20
